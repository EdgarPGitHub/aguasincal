{% extends 'panel/layout.twig' %}
{% block titulo %}Código de acceso{% endblock %}
{% block contenido %}
<div class="tarjeta panel__acceso">
  <h1>Código de verificación</h1>
  <p>Abre tu aplicación de autenticación (Google Authenticator, Authy…) y escribe el código de 6 cifras.</p>
  {% if error %}<p class="aviso aviso--error" role="alert">{{ error }}</p>{% endif %}
  <form method="post" action="{{ base }}?r=codigo">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <label class="campo"><span>Código</span><input name="codigo" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus></label>
    <button class="boton boton--ancho" type="submit">Entrar</button>
  </form>
</div>
{% endblock %}
