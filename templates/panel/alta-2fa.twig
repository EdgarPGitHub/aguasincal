{% extends 'panel/layout.twig' %}
{% block titulo %}Activar verificación en dos pasos{% endblock %}
{% block contenido %}
<div class="tarjeta panel__acceso">
  <h1>Activa la verificación en dos pasos</h1>
  <ol>
    <li>Instala en el móvil Google Authenticator, Microsoft Authenticator o Authy.</li>
    <li>Escanea este código QR (o escribe la clave a mano).</li>
    <li>Escribe el código de 6 cifras que te muestra la aplicación.</li>
  </ol>
  <p class="qr"><img src="{{ qr }}" alt="Código QR para la aplicación de autenticación" width="220" height="220"></p>
  <p>Clave manual: <code class="clave-manual">{{ secreto }}</code></p>
  {% if error %}<p class="aviso aviso--error" role="alert">{{ error }}</p>{% endif %}
  <form method="post" action="{{ base }}?r=alta-2fa">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <label class="campo"><span>Código</span><input name="codigo" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required></label>
    <button class="boton boton--ancho" type="submit">Activar y entrar</button>
  </form>
</div>
{% endblock %}
