{% extends 'base.twig' %}
{% block contenido %}
<div class="contenedor">
  <header class="cabecera-pagina">
    <h1>{{ pagina.titulo }}</h1>
    <p class="entradilla">{{ pagina.entradilla }}</p>
  </header>
  {% for grupo in grupos %}
  <section class="bloque">
    <h2>{{ grupo.nombre }}</h2>
    <ul class="rejilla rejilla--2 lista-guias">
      {% for g in grupo.guias %}
      <li class="tarjeta tarjeta--enlace"><h3><a href="{{ g.ruta }}">{{ g.titulo }}</a></h3><p>{{ g.descripcion }}</p></li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</div>
{% endblock %}
