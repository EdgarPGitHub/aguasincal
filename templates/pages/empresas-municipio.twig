{% extends 'base.twig' %}
{% block contenido %}
<div class="contenedor columnas">
  <article class="columnas__principal">
    <header class="cabecera-pagina">
      <h1>{{ pagina.titulo }}</h1>
      <p class="entradilla">{{ pagina.entradilla }}</p>
      {% if dureza %}<p class="nota">El agua de {{ m.nombre }} tiene {{ dureza.fh|num(1) }} °fH ({{ dureza(dureza.fh).nombre|lower }}). <a href="{{ dureza.ruta }}">Ver los datos del agua de {{ m.nombre }}</a>.</p>{% endif %}
    </header>

    <nav class="filtros" aria-label="Filtrar por servicio">
      <a href="{{ pagina.ruta }}"{{ servicio is null ? ' aria-current="page"' }}>Todas</a>
      {% for clave, s in servicios_lista %}{% if clave != 'comunidades' %}<a href="{{ pagina.ruta }}?servicio={{ clave }}" rel="nofollow"{{ servicio == clave ? ' aria-current="page"' }}>{{ s.nombre }}</a>{% endif %}{% endfor %}
    </nav>

    {% if empresas %}
      <ol class="empresas">
        {% for e in empresas %}{% include 'components/empresa-tarjeta.twig' with {e: e, m: m, servicios_lista: servicios_lista} only %}{% endfor %}
      </ol>
      <p class="nota">Orden: primero las destacadas; después, por cercanía. Cada empresa indica hasta dónde trabaja.</p>
    {% else %}
      <p class="aviso">Todavía no hay empresas{{ servicio ? ' de ' ~ (servicios_lista[servicio].nombre|lower) }} que trabajen en {{ m.nombre }}. Pide presupuesto y te buscamos un profesional de la zona.</p>
    {% endif %}

    <section class="bloque tarjeta cta-empresa">
      <h2>¿Trabajas en {{ m.nombre }}?</h2>
      <p>Da de alta tu empresa gratis y aparece en esta página.</p>
      <p><a class="boton boton--sec" href="/empresas/alta/">Dar de alta mi empresa</a></p>
    </section>
  </article>
  <aside class="columnas__lateral">
    <div class="tarjeta pegajosa">
      {% include 'components/formulario.twig' with {servicio: servicio ?: 'descalcificadores', origen: pagina.ruta, titulo: 'Presupuesto en ' ~ m.nombre, texto: 'Te ponemos en contacto con un profesional de la zona.'} only %}
    </div>
  </aside>
</div>
{% endblock %}
