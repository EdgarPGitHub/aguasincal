{% extends 'base.twig' %}
{% set body_class = 'pagina-form' %}
{% block contenido %}
<div class="contenedor contenedor--form">
  <header class="cabecera-pagina">
    <h1>{{ pagina.titulo }}</h1>
    <p class="entradilla">Estado de la ficha: <b>{{ empresa.ficha == 'publicada' ? 'publicada' : (empresa.ficha == 'pendiente' ? 'pendiente de revisión' : 'oculta') }}</b>{% if empresa.ficha == 'publicada' %} · <a href="/empresa/{{ empresa.slug }}/">ver ficha</a>{% endif %}.</p>
  </header>
  {% if hecho %}<p class="aviso aviso--ok" role="status">Cambios guardados.</p>{% endif %}
  <div class="tarjeta">
  <form action="/empresas/editar/" method="post" novalidate>
    <input type="hidden" name="t" value="{{ token }}">
    {% include 'components/empresa-campos.twig' with {datos: datos, errores: errores, sugerencias: sugerencias, servicios_lista: servicios_lista, radios: radios, provincias: provincias, con_email: false} only %}
    <button class="boton boton--ancho" type="submit">Guardar cambios</button>
  </form>
  </div>
  <p class="nota">¿Quieres salir el primero en tu zona y mostrar tu teléfono y tu web? Responde al email del enlace y te contamos cómo destacar la ficha.</p>
</div>
{% endblock %}
