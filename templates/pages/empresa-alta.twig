{% extends 'base.twig' %}
{% set body_class = 'pagina-form' %}
{% block contenido %}
<div class="contenedor contenedor--form">
{% if hecho %}
  <div class="tarjeta resultado">
    <h1>¡Gracias!</h1>
    <p class="entradilla">Te hemos enviado un email para confirmar tu dirección. Revisamos cada alta a mano y te avisaremos cuando la ficha esté publicada.</p>
    <p class="nota">Si no te llega en unos minutos, mira en la carpeta de spam.</p>
  </div>
{% else %}
  <header class="cabecera-pagina">
    <h1>{{ pagina.titulo }}</h1>
    <p class="entradilla">Aparece en los municipios donde trabajas y recibe por email las solicitudes de los clientes. La ficha básica es gratis.</p>
  </header>
  {% if errores.general is defined %}<p class="aviso aviso--error" role="alert">{{ errores.general }}</p>{% endif %}
  <div class="tarjeta">
  <form action="/empresas/alta/" method="post" novalidate>
    <input type="hidden" name="token" value="{{ token }}">
    <div class="trampa" aria-hidden="true"><label>No rellenes este campo <input name="{{ trampa }}" tabindex="-1" autocomplete="off"></label></div>
    {% include 'components/empresa-campos.twig' with {datos: datos, errores: errores, sugerencias: sugerencias, servicios_lista: servicios_lista, radios: radios, provincias: provincias, con_email: true} only %}
    <label class="consentimiento{{ errores.acepto is defined ? ' campo--error' }}"><input type="checkbox" name="acepto" value="1"{{ datos.acepto ?? false ? ' checked' }}>
      <span>Declaro que represento a esta empresa y acepto las <a href="/condiciones-directorio/">condiciones del directorio</a> y la <a href="/privacidad/">política de privacidad</a>.</span></label>
    {% if errores.acepto is defined %}<em class="error">{{ errores.acepto }}</em>{% endif %}
    <button class="boton boton--ancho" type="submit">Enviar alta</button>
  </form>
  </div>
{% endif %}
</div>
{% endblock %}
