{% extends 'base.twig' %}
{% block contenido %}
<div class="contenedor">
  <header class="cabecera-pagina">
    <h1>{{ pagina.titulo }}</h1>
    <p class="entradilla">{{ pagina.entradilla }}</p>
  </header>
  <form class="buscador buscador--grande" action="/dureza-agua/" method="get" role="search" data-buscador>
    <label for="buscar-municipio">Busca tu municipio</label>
    <div class="buscador__fila">
      <input id="buscar-municipio" name="q" type="search" placeholder="Escribe tu municipio" autocomplete="off" aria-autocomplete="list" aria-controls="buscador-resultados">
      <button class="boton" type="submit">Buscar</button>
    </div>
    <ul id="buscador-resultados" class="buscador__resultados" role="listbox" hidden></ul>
  </form>

  <section class="bloque">
    <h2>Provincias</h2>
    <ul class="rejilla rejilla--3">
      {% for p in provincias_datos %}
      <li class="tarjeta tarjeta--enlace">
        <h3><a href="{{ p.ruta }}">{{ p.nombre }}</a></h3>
        {% if p.municipios_con_datos %}
          <p>{{ p.municipios_con_datos }} municipios con datos · media {{ p.media_fh|num }} °fH ({{ dureza(p.media_fh).nombre|lower }})</p>
        {% else %}
          <p>Datos en preparación.</p>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>

  <section class="bloque prosa">
    {{ contenido_html|raw }}
  </section>
</div>
{% endblock %}
