{% extends 'base.twig' %}
{% block contenido %}
<div class="contenedor">
  <header class="cabecera-pagina">
    <h1>{{ pagina.titulo }}</h1>
    <p class="entradilla">{{ pagina.entradilla }}</p>
  </header>
  <ul class="videos-lista">
    {% for v in videos %}
    <li class="tarjeta video-tarjeta">
      <a href="{{ v.ruta }}">
        <img src="{{ v.portada }}" alt="" width="1280" height="720" loading="lazy" decoding="async">
        <span class="video-tarjeta__titulo">{{ v.titulo }}</span>
      </a>
      <p class="nota">{{ v.duracion_texto }} min · {{ v.descripcion }}</p>
    </li>
    {% endfor %}
  </ul>
</div>
{% endblock %}
