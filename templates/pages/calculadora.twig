{% extends 'base.twig' %}
{% block contenido %}
<div class="contenedor columnas">
  <article class="columnas__principal">
    <header class="cabecera-pagina">
      <h1>{{ pagina.titulo }}</h1>
      <p class="entradilla">{{ pagina.entradilla }}</p>
    </header>
    {% include 'components/calculadora.twig' with {fh: null, dimensionados: []} only %}
    <section class="bloque">
      <h2>Tabla rápida: litros de resina recomendados</h2>
      <div class="tabla-scroll"><table>
        <thead><tr><th scope="col">Dureza</th>{% for p in tabla.personas %}<th scope="col">{{ p }} personas</th>{% endfor %}</tr></thead>
        <tbody>{% for fila in tabla.filas %}<tr><th scope="row">{{ fila.fh }} °fH</th>{% for d in fila.celdas %}<td>{{ d ? d.litros_resina ~ ' L' : '–' }}</td>{% endfor %}</tr>{% endfor %}</tbody>
      </table></div>
    </section>
    <div class="prosa">{{ contenido_html|raw }}</div>
  </article>
  <aside class="columnas__lateral">
    <div class="tarjeta pegajosa">
      {% include 'components/formulario.twig' with {servicio: 'descalcificadores', origen: pagina.ruta, titulo: 'Que te lo calcule un técnico', texto: 'Mide la dureza en tu casa y te propone el equipo adecuado.'} only %}
    </div>
  </aside>
</div>
{% endblock %}
