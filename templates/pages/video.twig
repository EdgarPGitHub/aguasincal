{% extends 'base.twig' %}
{% block contenido %}
<div class="contenedor columnas">
  <article class="columnas__principal">
    <header class="cabecera-pagina">
      <h1>{{ pagina.titulo }}</h1>
      <p class="entradilla">{{ video.descripcion }}</p>
    </header>
    {% include 'components/video.twig' with {v: video} only %}
    <section class="bloque prosa">
      <h2>Transcripción</h2>
      {% for parrafo in video.transcripcion %}<p>{{ parrafo }}</p>{% endfor %}
    </section>
    {% if relacionadas %}
    <section class="bloque">
      <h2>Para saber más</h2>
      <ul class="lista-enlaces">{% for r in relacionadas %}<li><a href="{{ r.ruta }}">{{ r.titulo }}</a></li>{% endfor %}</ul>
    </section>
    {% endif %}
    <p class="nota">Publicado el {{ video.publicado|fecha }}{% if video.actualizado != video.publicado %}, actualizado el {{ video.actualizado|fecha }}{% endif %}. {{ video.creditos }}</p>
    <div class="tarjeta cta-final">
      {% include 'components/formulario.twig' with {servicio: servicio_form, origen: pagina.ruta, titulo: '¿Quieres un presupuesto?', texto: 'Gratis y sin compromiso. Te atiende un profesional verificado de tu zona.'} only %}
    </div>
  </article>
  <aside class="columnas__lateral">
    {% if otros %}
    <nav class="tarjeta" aria-labelledby="otros-titulo">
      <h2 id="otros-titulo" class="lateral__titulo">Más vídeos</h2>
      <ul class="lista-enlaces">{% for o in otros %}<li><a href="{{ o.ruta }}">{{ o.titulo }}</a> <span class="nota">{{ o.duracion_texto }}</span></li>{% endfor %}</ul>
    </nav>
    {% endif %}
  </aside>
</div>
{% endblock %}
