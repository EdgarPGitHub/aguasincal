{#- Firma y fecha. Parámetro: pagina -#}
<p class="revision">
  {% if pagina.revisado_por ?? '' %}Revisado por <b>{{ pagina.revisado_por }}</b>{% if pagina.revisor_cargo ?? '' %}, {{ pagina.revisor_cargo }}{% endif %}. {% elseif pagina.autor ?? '' %}Por el <a href="/quienes-somos/">{{ pagina.autor }}</a>, con fuentes oficiales (<a href="/metodologia-datos/">cómo trabajamos</a>). {% endif %}
  {% if pagina.actualizado ?? '' %}Actualizado el <time datetime="{{ pagina.actualizado }}">{{ pagina.actualizado|fecha }}</time>.{% endif %}
</p>
