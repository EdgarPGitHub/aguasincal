{#- Medidor visual de dureza (SVG, sin estilos en línea por la CSP). Parámetros: fh (float|null) -#}
{%- set cat = dureza(fh) -%}
<figure class="medidor medidor--{{ cat.clave }}">
  <figcaption class="medidor__cabecera">
    <span class="medidor__valor">{% if fh is not null %}{{ fh|num(fh < 10 ? 1 : 0) }} <small>°fH</small>{% else %}Sin datos{% endif %}</span>
    <span class="medidor__categoria">{{ cat.nombre }}</span>
  </figcaption>
  <svg class="medidor__barra" viewBox="0 0 100 14" preserveAspectRatio="none" role="img"
       aria-label="{{ fh is not null ? 'Dureza ' ~ fh|num ~ ' grados franceses: ' ~ cat.nombre : 'Sin datos de dureza' }}">
    <rect x="0" y="4" width="25" height="6" fill="#2e9e6b"/>
    <rect x="25" y="4" width="25" height="6" fill="#d4ac2b"/>
    <rect x="50" y="4" width="16.67" height="6" fill="#e07b28"/>
    <rect x="66.67" y="4" width="33.33" height="6" fill="#c2412d"/>
    {% if fh is not null %}<rect x="{{ (cat.posicion - 0.6)|round(2) }}" y="0" width="1.2" height="14" fill="#0f1f33"/>{% endif %}
  </svg>
  <div class="medidor__escala" aria-hidden="true"><span class="e0">0</span><span class="e15">15</span><span class="e30">30</span><span class="e40">40</span><span class="e60">60+</span></div>
</figure>
